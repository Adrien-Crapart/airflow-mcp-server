# Example environment variables for airflow-mcp-server
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_API_TOKEN=

MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_REQUIRE_AUTH=true
# Required for remote clients when MCP_REQUIRE_AUTH=true
MCP_AUTH_TOKEN=
MCP_ENABLE_ADMIN_ENDPOINTS=false
MCP_READ_ONLY=false
MCP_TRANSPORT=both
LOG_LEVEL=INFO
